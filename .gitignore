# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment files
.env
.env.*
.hf/

# Pytest
.pytest_cache/
.pytest_cache/*
.coverage

# Weights & Biases
wandb

# uv
uv.lock

# Local tooling
/.swarm
/.claude-flow
ruvector.db
.mcp.json

# Generated audit results
outputs/

# Per-fact closure manifests (large, regenerated from the audit results)
/results/**/prompts_trex_closures/
/results/prompts_trex_adversarial/closures/

# Raw audit artifacts (kept locally; summaries remain versioned)
/results/**/*.jsonl
/results/**/*.npz
/results/**/run_audit.log
/results/prompts_trex_sweep/neighbors.json

# Downloaded model checkpoints
checkpoints/

# Downloaded wiki index (~113 GB)
/data/co-lmlm-wiki-index/

# Downloaded raw dataset caches (regenerated by data/prepare_*_audit.py)
/data/lama/
/data/counterfact.json
/data/zsre_mend_eval.json

# Opt-in paraphrase/neighborhood variant sets (EMIT_VARIANTS=1); not for the
# standard fact-level audit.
/data/prompts_*_variants.jsonl

# Coverage reports (regenerated by CI)
coverage.json
coverage.xml

# LaTeX build files (keep the report source and final PDF)
/reports/*.aux
/reports/*.fdb_latexmk
/reports/*.fls
/reports/*.log
/reports/*.out
/reports/*.synctex.gz

# Data
*.jsonl
*.json
